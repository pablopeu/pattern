{
  "name": "pattern-studio-2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "build": "npm run notices && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "monitor": "python3 scripts/work_monitor.py",
    "check": "tsc -b && vitest run",
    "notices": "node scripts/notices.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:monitor": "python3 scripts/test_monitor.py"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "paper": "^0.12.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "esbuild": true
  }
}
